# Optional development-only preview sync endpoint.
PREVIEW_SYNC_URL=

# Optional hosted 1688 collector endpoint. Leave unset for local Vite/CDP development.
VITE_1688_COLLECTOR_URL=

# Explicit workflow connection. Copy to an ignored local env file.
# Local is development-only; cloud must not fall back to local when incomplete.
VITE_WORKFLOW_MODE=local
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SELLER_OS_WORKSPACE_ID=
# Cloud API: Supabase Edge Function seller-os-agency, user JWT required.
# The hosted server uses its built-in runtime credentials; none are needed locally.
# Never prefix secret or service-role keys with VITE_.
